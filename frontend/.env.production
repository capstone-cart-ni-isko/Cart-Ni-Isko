# Production build (web + PWA share this one bundle, so this single value
# serves both).
#
# Vite gives an already-defined environment variable priority over any .env
# file, so a value configured in the hosting project (Vercel -> Settings ->
# Environment Variables) still wins; this file only guarantees the build has
# a real API origin instead of throwing "VITE_API_BASE_URL is required" and
# rendering a blank app when none was set.
#
# Must match the service in ../render.yaml (`cart-ni-isko-api`) and the CORS
# allow-list it carries.
VITE_API_BASE_URL=https://cart-ni-isko-api.onrender.com/api
