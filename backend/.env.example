APP_NAME="Cart ni Isko"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Supabase (Tokyo) ──
# Always go through the project's IPv4 connection pooler, never the direct
# host: `db.<ref>.supabase.co` is IPv6-only and does not resolve on Render.
#   5432 = transaction mode (this app; short-lived queries, no session state)
#   6543 = session mode (use only if a session-level feature is ever needed)
# The username must keep the `postgres.<project-ref>` pooler form.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require
# Reuse the TCP+TLS session across requests. A fresh handshake to Tokyo costs
# ~0.8 s on its own, which is the whole 1-second budget; a persistent handle
# keeps it out of every request after the first one.
DB_PERSISTENT=true

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Online payment (PayMongo) ──
# Business rule 55: a preorder - claimed by pickup OR delivery - may only be
# paid online, and so may its delivery fee. Leave the keys empty and the
# checkout answers 503 "online payment is not configured" instead of silently
# accepting an offline payment.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# Secret of the webhook ENDPOINT (Dashboard -> Settings -> Webhooks), used to
# verify the `Paymongo-Signature` header. Falls back to the secret key.
PAYMONGO_WEBHOOK_SECRET=
# Optional comma-separated override of the methods shown at checkout.
# PAYMONGO_METHODS=card,gcash,grab_pay,paymaya

# ── Courier (LalaMove) ──
# All optional. While empty, delivery fees fall back to the store's own
# priority/standard/saver table and the parcel is dispatched manually.
LALAMOVE_ENV=sandbox
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_MARKET=PH
LALAMOVE_LANGUAGE=en_PH
LALAMOVE_SERVICE_TYPE=MOTORCYCLE
# LALAMOVE_BASE_URL=

# Absolute origin of the SPA - where PayMongo sends the browser back to after
# the hosted checkout (/checkout?status=...). Must be the FRONTEND origin.
FRONTEND_URL=http://localhost:5173

# Notification Follow-ups (REQ-AN-03)
ENABLE_NOTIFICATION_FOLLOWUPS=true
